# ============================================================================
# AI Employee Vault - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control - it's excluded by .gitignore
# ============================================================================

# ============================================================================
# Odoo ERP Configuration
# ============================================================================
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_vault
ODOO_USER=admin
ODOO_PASSWORD=admin
ODOO_MARKETING_ACCOUNT=500000
ODOO_BASE_COST=500

# ============================================================================
# LinkedIn Credentials
# ============================================================================
LINKEDIN_EMAIL=your-linkedin-email@example.com
LINKEDIN_PASSWORD=your-linkedin-password

# ============================================================================
# Gmail Configuration
# ============================================================================
# Gmail API uses OAuth2 (credentials.json) - no username/password needed
# But you may need these for SMTP if used elsewhere:
GMAIL_USER=your-gmail-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ============================================================================
# Groq API (for AI Email Drafting)
# ============================================================================
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ============================================================================
# Vault Root Path
# ============================================================================
VAULT_ROOT=E:/hackathon_0_digital_fte/AI_Employee_vault

# ============================================================================
# Optional: Other API Keys (add as needed)
# ============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# TWITTER_API_KEY=...
# TWITTER_API_SECRET=...
# FACEBOOK_ACCESS_TOKEN=...
